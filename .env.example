# AWS S3 & Region
AWS_BUCKET_NAME=your-s3-bucket-name
AWS_REGION=ap-southeast-2

# S3 Storage Paths (Batch & Streaming)
BATCH_DELTA_PATH=s3a://your-s3-bucket-name/curated/delta/github_events
BATCH_QUARANTINE_PATH=s3a://your-s3-bucket-name/quarantine/github_events
STREAMING_DELTA_PATH=s3a://your-s3-bucket-name/curated/delta/github_events_streaming
STREAMING_QUARANTINE_PATH=s3a://your-s3-bucket-name/quarantine/github_events_streaming
AIRFLOW_CHECKPOINT_KEY=checkpoints/github_event_ids.json

# Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=github-events

# Local Machine Paths
STREAMING_CHECKPOINT_PATH=./checkpoints/github_events_streaming
JAVA_17_HOME=/path/to/your/openjdk-17